# ============================================================================
# Club Atlético Olimpo A.M. — Variables de entorno
# ----------------------------------------------------------------------------
# Copiá este archivo como `.env` y completá las credenciales reales de Turso:
#
#   cp .env.example .env
#
# Cómo obtenerlas (Turso CLI):
#   turso db create club-olimpo
#   turso db show club-olimpo            -> URL de conexión
#   turso db tokens create club-olimpo   -> Token de acceso
# ============================================================================

# ── Base de datos (Turso / libSQL en la nube) ───────────────────────────────
# URL de conexión remota. Formato: libsql://<nombre-db>.<organizacion>.turso.io
# El backend NUNCA usa bases de datos locales: la conexión es directa a Turso
# mediante el driver @prisma/adapter-libsql.
DATABASE_URL="libsql://TU-BASE-DE-DATOS.turso.io"

# Token de autenticación de Turso (se pasa al adapter de Prisma).
TURSO_AUTH_TOKEN="eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9..."

# ── Notas ───────────────────────────────────────────────────────────────────
# * Si DATABASE_URL no está definida (o la conexión falla), la API responde
#   automáticamente con los fixtures de demostración incluidos en /shared,
#   por lo que el sitio siempre es visible en desarrollo.
# * Para poblar la base con los datos iniciales:   npm run db:seed
# * Para generar el SQL del esquema y aplicarlo vía Turso CLI:
#       npm run db:schema:sql > schema.sql
#       turso db shell TU-BASE < schema.sql
