# ============================================================================
# Variables de entorno — copiá este archivo a `.env` y completá los valores.
# `.env` está gitignorado: las credenciales reales nunca se suben al repo.
# ============================================================================

# ── Turso (base de datos en la nube) ────────────────────────────────────────
# URL libSQL de la base:  turso db show <nombre> --url
DATABASE_URL="libsql://TU-BASE-DE-DATOS.turso.io"

# Token de acceso:        turso db tokens create <nombre>
TURSO_AUTH_TOKEN=""

# ── Panel de administración ─────────────────────────────────────────────────
# Contraseña del login (POST /api/auth/login). Sin esta variable el panel
# queda deshabilitado (503 admin_not_configured). Usá una contraseña larga
# y única, distinta de cualquier otra credencial.
ADMIN_PASSWORD=""

# Secreto con el que se firman los tokens de sesión (HMAC-SHA256).
# Generarlo con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Si se omite, se deriva de ADMIN_PASSWORD (y cambiarla invalida las sesiones).
SESSION_SECRET=""

# Duración de la sesión en horas (entre 1 y 720). Por defecto: 12.
ADMIN_SESSION_HOURS="12"
